{
  "name": "spikedrop",
  "version": "1.0.0",
  "description": "Valorant & Spotify Global Audio Switcher",
  "main": "./out/main/index.js",
  "author": "SpikeDrop",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "compile:helper": "powershell -ExecutionPolicy Bypass -File ./scripts/compile-audio-helper.ps1",
    "build:win": "npm run build && electron-builder --win --x64"
  },
  "keywords": [
    "valorant",
    "spotify",
    "audio-switcher",
    "electron",
    "wasapi"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "electron-store": "^12.0.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "com.spikedrop.app",
    "productName": "SpikeDrop",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.png"
    },
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ]
  }
}
